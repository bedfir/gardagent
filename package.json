{
  "name": "gardagent",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedfir/gardagent.git"
  },
  "version": "0.3.0",
  "description": "Governance gateway for AI agents",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc -b && pnpm --filter @gardagent/console typecheck",
    "dev:console": "pnpm --filter @gardagent/console dev",
    "report": "pnpm --filter @gardagent/report start --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.44"
  },
  "homepage": "https://github.com/bedfir/gardagent#readme",
  "bugs": {
    "url": "https://github.com/bedfir/gardagent/issues"
  }
}
