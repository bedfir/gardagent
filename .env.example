# Copy this file to .env and fill in the values.

# Provider: OpenCode Go (https://opencode.ai). Base URLs are written without a trailing /v1:
# the gateway appends /v1/chat/completions and /v1/messages.
# OpenAI-compatible format:
UPSTREAM_BASE_URL=https://opencode.ai/inference/go/openai
UPSTREAM_API_KEY=replace-with-provider-key

# Anthropic Messages format (POST /v1/messages).
ANTHROPIC_UPSTREAM_BASE_URL=https://opencode.ai/inference/go/anthropic
# Key specific to the Anthropic endpoint; if absent, the gateway uses UPSTREAM_API_KEY.
# ANTHROPIC_UPSTREAM_API_KEY=replace-with-anthropic-key

# Client headers forwarded to the provider: comma-separated list, case-insensitive.
# Default: x-opencode-session, required by OpenCode Go. If missing, the gateway generates a
# stable one per agent and per day. Empty list = no header forwarded or generated.
# authorization, x-api-key, cookie, host, content-length and hop-by-hop headers are never forwarded.
# The gateway always sends its own User-Agent (Gardagent/<version>).
# UPSTREAM_FORWARD_HEADERS=x-opencode-session

# Token for the /admin routes: a long random string (e.g. openssl rand -hex 32).
# At least 32 characters: shorter values are refused at startup.
GARDAGENT_ADMIN_TOKEN=replace-with-a-long-token

# Failed authentications (admin token or agent key) per source address and window before the gateway answers
# 429 with a Retry-After header; 0 disables the limit. Counters live in the memory of the process.
# GARDAGENT_AUTH_FAIL_LIMIT=10
# GARDAGENT_AUTH_FAIL_WINDOW_MS=60000
# Where the client address comes from. Default false: the socket address (behind a proxy every client would then
# share the proxy's address). Set "true" ONLY if the gateway is reachable exclusively through a reverse proxy that
# overwrites X-Forwarded-For (the deploy/ stack does this with Caddy), or list the proxy addresses/CIDRs.
# GARDAGENT_TRUST_PROXY=false

# Enforcement mode: enforce (default) blocks policy violations; observe forwards them
# and logs the reason with an "observed:" prefix. Use observe to measure what the rules would block without blocking it.
# GARDAGENT_MODE=enforce

# Database outage behavior. fail-closed (default): while PostgreSQL is down, new requests get 503.
# fail-open: ONLY honored with GARDAGENT_MODE=observe (ignored, with a startup warning, in enforce mode).
# LLM requests keep flowing and each ledger entry is fsynced to the spool before the response completes;
# if the spool is unwritable or full the gateway answers 503 anyway. MCP write tools and any call needing
# approval are refused during the outage; admin routes need the database.
# GARDAGENT_DB_OUTAGE=fail-closed
# Hard cap of the ledger spool file in bytes (default 67108864 = 64 MiB; minimum 4096).
# GARDAGENT_SPOOL_MAX_BYTES=67108864
# Database timeouts (milliseconds, 50..60000). A request-path database call (agent lookup, budget, ledger write)
# that does not answer within CALL_TIMEOUT declares the database unreachable at once: streams in flight end
# without waiting for the driver's own timeouts, and the ledger row goes to the spool.
# GARDAGENT_DB_CALL_TIMEOUT_MS=600
# Maximum wait of the health probe (/health and the replay timer).
# GARDAGENT_DB_PROBE_TIMEOUT_MS=800
# Maximum wait for a pooled connection.
# GARDAGENT_DB_CONNECT_TIMEOUT_MS=2000
# Lifetime of a cached agent, in ms (1000 to 600000). Healthy database: always re-read. Outage (fail-open):
# an agent is served only up to this age plus a fixed 120 s grace window, then refused. Admin changes drop it at once.
# GARDAGENT_AGENT_CACHE_TTL_MS=30000

POSTGRES_PASSWORD=replace-with-a-password

# Prices in USD per million tokens, for the models used (optional).
# deepseek-v4.1-flash: full-rate price, to be safe.
GARDAGENT_PRICES={"mimo-v2.6-flash":{"input":0.14,"output":0.28},"glm-5.3-flash":{"input":0.15,"output":0.5},"qwen3.8-flash":{"input":0.15,"output":0.47},"minimax-m3":{"input":0.3,"output":1.2},"deepseek-v4.1-flash":{"input":0.3,"output":1.2}}

# Private access from your devices via Tailscale (optional, see docker-compose.tailscale.yml).
# Key generated in the Tailscale console: Settings > Keys > Generate auth key.
# TS_AUTHKEY=tskey-auth-...
